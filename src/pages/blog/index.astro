---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { formatPostDate, getPublishedPosts, postPath, publicSrc } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<Layout title="Blog">
  <Header />
  <article class="skills-page">
    <div class="container">
      <h1>Blog</h1>
      {posts.length === 0 ? (
        <p class="empty-note">Posts coming soon.</p>
      ) : (
        <div class="blog-grid">
          {posts.map((post) => (
            <article class="blog-card">
              {post.data.image && <img src={publicSrc(post.data.image)} alt="" />}
              <div class="blog-date">
                <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
                {post.data.draft && <span class="draft-badge">Draft</span>}
              </div>
              <h2><a href={postPath(post.id)}>{post.data.title}</a></h2>
              <p>{post.data.excerpt}</p>
              <a href={postPath(post.id)} class="read-more">Read More</a>
            </article>
          ))}
        </div>
      )}
    </div>
  </article>
  <Footer />
</Layout>
