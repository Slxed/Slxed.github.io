---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { homeHref } from '../lib/posts';
import { latestUpdate } from '../site';

function publicFile(urlPath: string): string | undefined {
  const rel = urlPath.replace(/^\//, '');
  return existsSync(join(process.cwd(), 'public', rel)) ? `/${rel}` : undefined;
}

const headshot =
  publicFile('/headshot.jpg') ??
  publicFile('/headshot.jpeg') ??
  publicFile('/headshot.png') ??
  publicFile('/headshot.webp');

const mapImage =
  publicFile('/projects/wi-school-spending.png') ??
  publicFile('/projects/wi-school-spending.jpg') ??
  publicFile('/projects/wi-school-spending.webp') ??
  'https://raw.githubusercontent.com/Slxed/wi-school-spending/main/map/wi_spending_vs_graduation.png';
---

<Layout>
  <Header />

  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1>William Day </h1>
        <p class="subtitle">
          I'm a junior at UW–Madison studying Data Science and Cartography &amp; GIS.
        </p>
        <p class="currently">{latestUpdate}</p>
        <p class="hero-links">
          <a href="https://github.com/Slxed">github.com/Slxed</a>
          <a href="https://www.linkedin.com/in/william-day-5b73112bb/">LinkedIn</a>
          <a href="mailto:weday@wisc.edu">weday@wisc.edu</a>
          <a href={homeHref('experience')}>View my work</a>
        </p>
      </div>
      <div class="hero-image">
        <div class="headshot-placeholder">
          {headshot ? (
            <img src={headshot} alt="William Day" />
          ) : (
            <span aria-hidden="true">WD</span>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="about">
    <div class="container">
      <p class="about-text">I'm a junior at the University of Wisconsin–Madison, graduating in May 2028 with a B.S. in Data Science and a B.S. in Cartography &amp; GIS. I have hands-on experience working with tabular and spatial data in both professional and academic settings. I focus on data analysis and finding the trends underneath a dataset, and I'm always looking to learn new tools along the way, mainly machine learning and web maps as of right now.</p>
    </div>
  </section>

  <section class="highlights">
    <div class="container">
      <div class="section-header">
        <h2>Highlights</h2>
      </div>
      <div class="project-index">
        <article class="project-row">
          <div class="project-info">
            <h3><a href={homeHref('experience#doit')}>UW–Madison Division of Information Technology (DoIT)</a></h3>
            <p class="project-line">Help Desk Agent since July 2026, triaging tickets in WiscIT.</p>
          </div>
        </article>
        <article class="project-row">
          <a class="project-thumb" href={homeHref('projects/wi-school-spending')} tabindex="-1" aria-hidden="true">
            <img src={mapImage} alt="" />
          </a>
          <div class="project-info">
            <h3><a href={homeHref('projects/wi-school-spending')}>Wisconsin Public School Spending Analysis</a></h3>
            <p class="project-line">2023–24 spending and graduation for 421 Wisconsin districts, mapped in ArcGIS Pro.</p>
          </div>
        </article>
        <article class="project-row">
          <div class="project-info">
            <h3><a href={homeHref('projects/crypto-diversification')}>Crypto Diversification Analysis</a></h3>
            <p class="project-line">Bitcoin's correlation with the S&amp;P 500 rose to about 0.39 after 2020.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
