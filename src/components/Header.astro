---
import { homeHref, publicSrc } from '../lib/posts';
---

<header>
  <div class="container">
    <a href={homeHref()} class="logo">https://slxed.github.io/</a>
    <nav>
      <ul>
        <li><a href={homeHref()}>Home</a></li>
        <li><a href={homeHref('experience')}>Experience</a></li>
        <li><a href={homeHref('skills')}>Skills</a></li>
        <li><a href={homeHref('blog')}>Blog</a></li>
        <li><a href={publicSrc('/William_Day_Resume.pdf')} target="_blank" rel="noopener noreferrer">Resume</a></li>
      </ul>
    </nav>
    <button type="button" class="theme-toggle" id="theme-toggle">Dark</button>
  </div>
</header>

<script>
  const button = document.getElementById('theme-toggle');

  function paint(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    const dark = theme === 'dark';
    if (button) button.textContent = dark ? 'Light' : 'Dark';
  }

  paint(document.documentElement.getAttribute('data-theme') || 'light');

  button?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    localStorage.setItem('theme', next);
    paint(next);
  });
</script>
