---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { formatPostDate, getPublishedPosts, postPath, publicSrc } from '../lib/posts';

const posts = await getPublishedPosts();
---

<Layout>
<Header />

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <h1>William Day </h1>
      <p class="subtitle">
        <!-- Add your title/role here -->
        I'm a Data Science student focusing on analytics and data governance, with a secondary focus on GIS.
      </p>
      <p class="description">
        <!-- Add your brief bio here -->
        Whether you are looking for trends within data, data warehousing and governance, or data engineering, I'm here to help you turn data into real, actionable insights. 
      </p>
      <div class="cta-container">
        <a href="#" class="social-link"><i class="fa-brands fa-github"></i></a>
        <a href="#" class="social-link"><i class="fa-brands fa-linkedin"></i></a>
        <a href="#" class="social-link"><i class="fa-brands fa-twitter"></i></a>
        <a href="#" class="social-link"><i class="fa-brands fa-instagram"></i></a>
        <a href="#projects" class="cta-button secondary">View my work</a>
      </div>
    </div>
    <div class="hero-image">
      <!-- Add your headshot here -->
      <div class="headshot-placeholder">
        <!-- Replace with: <img src="your-headshot.jpg" alt="William Day"> -->
        <i class="fa-solid fa-user"></i>
      </div>
    </div>
  </div>
</section>

<section id="about" class="about">
  <div class="container">
    <div class="section-header">
      <h2>About Me</h2>
      <p>Learn more about my background and skills</p>
    </div>
    <div class="about-content">
      <div class="about-text">
        <!-- Add your detailed bio here -->
        <p>Info Paragraph 1</p>
        <p>Info Paragraph 2</p>

        <!-- Add your skills here -->
        <div class="skills">
          <h3>Skills</h3>
          <ul>
            <li>R(Tidyverse, GGPlot2, Shiny)</li>
            <li>SQL, Python(Pandas, Matplotlib, Beautiful Soup, Numpy)</li>
            <li>GIS(ArcGIS Pro, GeoPandas, Spatial Joins)</li>
            <li>Data Cleaning</li>
            <li>Boot Strapping and Statistical Testing</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="projects" class="projects">
  <div class="container">
    <div class="section-header">
      <h2>My Projects</h2>
      <p>A selection of my recent work</p>
    </div>
    <div class="projects-grid">
      <!-- Project 1 -->
      <div class="project-card">
        <div class="project-image">
          <!-- Replace with actual project screenshot -->
          <div class="image-placeholder">
            <!-- Replace with: <img src="project1.jpg" alt="Project 1"> -->
            <i class="fa-solid fa-image"></i>
          </div>
        </div>
        <div class="project-info">
          <h3>Crypto Diversification Analysis</h3>
          <p>Brief description of the project, technologies used, and your role in it.</p>
          <div class="project-links">
            <a href="#" class="project-link"><i class="fa-solid fa-link"></i> Live Demo</a>
            <a href="#" class="project-link"><i class="fa-brands fa-github"></i> Source Code</a>
          </div>
        </div>
      </div>

      <!-- Project 2 -->
      <div class="project-card">
        <div class="project-image">
          <!-- Replace with actual project screenshot -->
          <div class="image-placeholder">
            <!-- Replace with: <img src="project2.jpg" alt="Project 2"> -->
            <i class="fa-solid fa-image"></i>
          </div>
        </div>
        <div class="project-info">
          <h3>Wisconsin Public School Spending</h3>
          <p>Brief description of the project, technologies used, and your role in it.</p>
          <div class="project-links">
            <a href="#" class="project-link"><i class="fa-solid fa-link"></i> Live Demo</a>
            <a href="#" class="project-link"><i class="fa-brands fa-github"></i> Source Code</a>
          </div>
        </div>
      </div>

      <!-- Project 3 -->
      <div class="project-card">
        <div class="project-image">
          <!-- Replace with actual project screenshot -->
          <div class="image-placeholder">
            <!-- Replace with: <img src="project3.jpg" alt="Project 3"> -->
            <i class="fa-solid fa-image"></i>
          </div>
        </div>
        <div class="project-info">
          <h3>AI-Assisted Querying of Cleaned Data</h3>
          <p>Brief description of the project, technologies used, and your role in it.</p>
          <div class="project-links">
            <a href="#" class="project-link"><i class="fa-solid fa-link"></i> Live Demo</a>
            <a href="#" class="project-link"><i class="fa-brands fa-github"></i> Source Code</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{posts.length > 0 && (
  <section id="blog" class="blog">
    <div class="container">
      <div class="section-header">
        <h2>Blog</h2>
        <p>Thoughts, tutorials, and insights</p>
      </div>
      <div class="blog-grid">
        {posts.map((post) => (
          <div class="blog-card">
            {post.data.image && <img src={publicSrc(post.data.image)} alt="" />}
            <div class="blog-date">
              <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
              {post.data.draft && <span class="draft-badge">Draft</span>}
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.excerpt}</p>
            <a href={postPath(post.id)} class="read-more">Read More <i class="fa-solid fa-arrow-right"></i></a>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<Footer />
</Layout>
