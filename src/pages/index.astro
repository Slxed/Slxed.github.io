---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { formatPostDate, getPublishedPosts, postPath, publicSrc } from '../lib/posts';

const posts = await getPublishedPosts();

function publicFile(urlPath: string): string | undefined {
  const rel = urlPath.replace(/^\//, '');
  return existsSync(join(process.cwd(), 'public', rel)) ? `/${rel}` : undefined;
}

function projectShot(base: string): string | undefined {
  for (const ext of ['png', 'jpg', 'jpeg', 'webp']) {
    const found = publicFile(`/projects/${base}.${ext}`);
    if (found) return found;
  }
}

const headshot =
  publicFile('/headshot.jpg') ??
  publicFile('/headshot.jpeg') ??
  publicFile('/headshot.png') ??
  publicFile('/headshot.webp');

const projects = [
  {
    title: 'Crypto Diversification Analysis',
    image: projectShot('crypto-diversification'),
    demo: 'https://slxed.github.io/crypto-diversification/',
    source: 'https://github.com/Slxed/crypto-diversification',
    body: 'Analyzed daily returns for 8 assets (Bitcoin, Ethereum, S&P 500, gold, bonds and others) in R with rolling correlations; found Bitcoin\'s correlation with S&P 500 rose from near zero before 2020 to about 0.39 after (Fisher z-test, bootstrap; p < 0.001). Showed the correlation was even higher during market stress such as COVID, the FTX collapse, and the 2022 rate hikes, when a diversifier is needed most. Built 4 interactive plotly charts (a two-panel time series, a heatmap, grouped bars, and a risk vs. correlation scatter plot) to show that Bitcoin stopped being a diversifier after 2020, in a form readers without a finance background can follow.',
  },
  {
    title: 'Wisconsin Public School Spending',
    image: projectShot('wi-school-spending'),
    source: 'https://github.com/Slxed/wi-school-spending',
    body: 'I looked at how much Wisconsin public school districts spend per student. I utilized SQL queries, Microsoft Excel, and Python scripts to fully clean, sort, and merge multiple datasets of 421 districts from the Department of Public Instruction\'s 2023–24 data. Then I joined the data to district boundaries in ArcGIS Pro and built a bivariate choropleth map of spending per student against graduation rate.',
  },
  {
    title: 'AI-Assisted Querying of Cleaned Data',
    image: projectShot('ai-data-cleaner'),
    source: 'https://github.com/Slxed/ai-data-cleaner-WIP',
    body: 'A Python pipeline that cleans a particular NY dataset. Tools: Python, pandas, NumPy, Matplotlib. Next step: send the cleaning log to an LLM for a data quality report, and turn plain-English questions into queries.',
  },
];
---

<Layout>
<Header />

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <h1>William Day </h1>
      <p class="subtitle">
        <!-- Add your title/role here -->
        I'm a Data Science student focusing on analytics and data governance, with a secondary focus on GIS.
      </p>
      <p class="description">
        <!-- Add your brief bio here -->
        Whether you are looking for trends within data, data warehousing and governance, or data engineering, I'm here to help you turn data into real, actionable insights. 
      </p>
      <div class="cta-container">
        <a href="https://github.com/Slxed" class="social-link" aria-label="GitHub"><i class="fa-brands fa-github"></i></a>
        <a href="https://www.linkedin.com/in/william-day-5b73112bb/" class="social-link" aria-label="LinkedIn"><i class="fa-brands fa-linkedin"></i></a>
        <a href="mailto:weday@wisc.edu" class="social-link" aria-label="Email"><i class="fa-solid fa-envelope"></i></a>
        <a href="/William_Day_Resume.pdf" class="cta-button">Resume</a>
        <a href="#projects" class="cta-button secondary">View my work</a>
      </div>
    </div>
    <div class="hero-image">
      <div class="headshot-placeholder">
        {headshot ? (
          <img src={headshot} alt="William Day" />
        ) : (
          <span aria-hidden="true">WD</span>
        )}
      </div>
    </div>
  </div>
</section>

<section id="about" class="about">
  <div class="container">
    <div class="section-header">
      <h2>About Me</h2>
      <p>Learn more about my background and skills</p>
    </div>
    <div class="about-content">
      <div class="about-text">
        <p>I'm a junior at UW–Madison studying Data Science and Cartography &amp; GIS. I expect to graduate in May 2028 with a B.S. in Data Science and a B.S. in Cartography &amp; GIS.</p>
        <p>In both professional and academic contexts I have hands-on experience working with data and turning it into actionable insights. Most of the work was getting messy spreadsheets to agree, and honestly that's the part I like. In summer 2027 I'll be a Data Analytics Intern at Mercury Marine.</p>

        <div class="skills">
          <h3>Skills</h3>
          <ul>
            <li>Python (pandas, NumPy, Matplotlib, Beautiful Soup)</li>
            <li>R (tidyverse, ggplot2, Shiny)</li>
            <li>SQL</li>
            <li>Excel</li>
            <li>Jupyter</li>
            <li>ArcGIS Pro</li>
            <li>spatial joins</li>
            <li>choropleth mapping</li>
            <li>data classification</li>
            <li>Adobe Illustrator</li>
            <li>Git/GitHub</li>
            <li>RStudio</li>
            <li>regression analysis</li>
            <li>technical documentation</li>
            <li>data storytelling</li>
            <li>data visualization</li>
            <li>bootstrapping</li>
            <li>data cleaning</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="projects" class="projects">
  <div class="container">
    <div class="section-header">
      <h2>My Projects</h2>
      <p>A selection of my recent work</p>
    </div>
    <div class="projects-grid">
      {projects.map((project) => (
        <div class="project-card">
          <div class="project-image">
            {project.image ? (
              <img src={project.image} alt="" />
            ) : (
              <div class="image-placeholder" aria-hidden="true"></div>
            )}
          </div>
          <div class="project-info">
            <h3>{project.title}</h3>
            <p>{project.body}</p>
            <div class="project-links">
              {project.demo && (
                <a href={project.demo} class="project-link"><i class="fa-solid fa-link"></i> Live Demo</a>
              )}
              {project.source && (
                <a href={project.source} class="project-link"><i class="fa-brands fa-github"></i> Source Code</a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

{posts.length > 0 && (
  <section id="blog" class="blog">
    <div class="container">
      <div class="section-header">
        <h2>Blog</h2>
        <p>Thoughts, tutorials, and insights</p>
      </div>
      <div class="blog-grid">
        {posts.map((post) => (
          <div class="blog-card">
            {post.data.image && <img src={publicSrc(post.data.image)} alt="" />}
            <div class="blog-date">
              <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
              {post.data.draft && <span class="draft-badge">Draft</span>}
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.excerpt}</p>
            <a href={postPath(post.id)} class="read-more">Read More <i class="fa-solid fa-arrow-right"></i></a>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<Footer />
</Layout>
